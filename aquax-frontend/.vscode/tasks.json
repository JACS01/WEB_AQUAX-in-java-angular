{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AquaX: instalar dependencias",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["ci"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "AquaX: iniciar frontend",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["start", "--", "--host", "localhost", "--port", "4200"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building|Changes detected",
          "endsPattern": "Local:.*https?://"
        }
      },
      "runOptions": { "instanceLimit": 1 },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "AquaX: ejecutar pruebas",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["test", "--", "--watch=false"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "AquaX: compilar produccion",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["run", "build"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
